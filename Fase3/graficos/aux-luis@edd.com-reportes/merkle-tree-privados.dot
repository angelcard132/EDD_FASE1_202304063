digraph ArbolMerkle {
  rankdir=TB;
  node [style=filled, fontname="Arial", fontsize=9];
  edge [fontname="Arial", fontsize=8];
  label="🔒 ÁRBOL DE MERKLE - CORREOS PRIVADOS\\nEstructura Criptográfica para Integridad de Datos\\nTotal Correos: 3"; labelloc=t; fontsize=14; fontcolor=purple;

  subgraph cluster_leyenda {
    label="🔐 Leyenda del Merkle Tree";
    style=filled;
    fillcolor="#F0F8FF";
    fontcolor=navy;
    leyenda_hoja [label="🔒 Correo Privado\\n(Hoja con datos)", fillcolor="#FFE4E1", shape="box", style="filled,rounded"];
    leyenda_nodo [label="🌳 Nodo Merkle\\n(Hash combinado)", fillcolor="#E6F3FF", shape="diamond"];
    leyenda_izq [label="Hijo Izquierdo", color="green", style="bold"];
    leyenda_der [label="Hijo Derecho", color="blue", style="bold"];
    leyenda_info [label="📋 Propiedades:\\n• Hash = MD5(datos)\\n• Integridad garantizada\\n• Detección de cambios\\n• Verificación rápida", shape="note", fillcolor="#FFFFCC"];
  }

  nodo_1 [label="🌳 NODO MERKLE\\nNivel: Interno\\nHash: 932e8c9f276f\\nHijos: L+R", fillcolor="#E6F3FF", shape="diamond", style="filled"];
  nodo_2 [label="🔒 CORREO PRIVADO\\nID: 4\\nDe: aux-marcosg@edd.com\\nPara: aux-luis@edd.com\\nAsunto: Confirmacion de reunion\\nFecha: 23-10-2025 14:51\\nHash: 49cd8489bdfa", fillcolor="#FFE4E1", shape="box", style="filled,rounded"];
  nodo_1 -> nodo_2 [label="Izq", color="green", fontcolor="green", penwidth=2];
  nodo_3 [label="🌳 NODO MERKLE\\nNivel: Interno\\nHash: b0e0fa2368f5\\nHijos: L+R", fillcolor="#E6F3FF", shape="diamond", style="filled"];
  nodo_4 [label="🔒 CORREO PRIVADO\\nID: 13\\nDe: aux-sofia@edd.com\\nPara: aux-luis@edd.com\\nAsunto: Consulta tecnica\\nFecha: 23-10-2025 14:52\\nHash: 20155d8f0432", fillcolor="#FFE4E1", shape="box", style="filled,rounded"];
  nodo_3 -> nodo_4 [label="Izq", color="green", fontcolor="green", penwidth=2];
  nodo_5 [label="🔒 CORREO PRIVADO\\nID: 11\\nDe: aux-carlos@edd.com\\nPara: aux-luis@edd.com\\nAsunto: Revision de documentacion\\nFecha: 23-10-2025 14:52\\nHash: 0cac62e29a3e", fillcolor="#FFE4E1", shape="box", style="filled,rounded"];
  nodo_3 -> nodo_5 [label="Der", color="blue", fontcolor="blue", penwidth=2];
  nodo_1 -> nodo_5 [label="Der", color="blue", fontcolor="blue", penwidth=2];

  subgraph cluster_info {
    label="ℹ️ Información del Árbol";
    style=filled;
    fillcolor="#F5F5DC";
    info_total [label="📊 Total Correos: 3", shape="note"];
    info_hash [label="🔐 Hash Raíz:\\n932e8c9f276f5ec6...", shape="note"];
    info_estructura [label="🌳 Estructura:\\nCada nodo = Hash(hijo_izq + hijo_der)\\nHojas = Hash(datos_correo)", shape="note"];
  }
  nodo_1 -> info_hash [style="dotted", color="gray", arrowhead="none"];
}
