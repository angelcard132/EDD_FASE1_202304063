digraph BorradoresAVL {
  rankdir=TB;
  node [style=filled, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=8];
  label="📝 BORRADORES (ÁRBOL AVL) - aux-luis@edd.com\\nEstructura: Rojo=Izquierdo, Azul=Derecho"; labelloc=t; fontsize=14; fontcolor=purple;

  subgraph cluster_leyenda {
    label="Leyenda";
    style=filled;
    fillcolor=lightgray;
    leyenda_raiz [label="Nodos Cercanos\\na la Raíz", fillcolor="#E6F3FF", shape="diamond"];
    leyenda_inter [label="Nodos\\nIntermedios", fillcolor="#FFF2E6", shape="diamond"];
    leyenda_hoja [label="Nodos\\nProfundos", fillcolor="#FFE6E6", shape="diamond"];
    leyenda_izq [label="Hijo Izquierdo", color="red"];
    leyenda_der [label="Hijo Derecho", color="blue"];
  }

