    leyenda_contacto [label="📧 CONTACTO\\n(En lista)", fillcolor="#32CD32", fontcolor=white, shape="ellipse", style="filled", width=1.2, height=0.8];
    leyenda_comun [label="❤️ CONTACTO\\nEN COMÚN", fillcolor="#FF6347", fontcolor=white, shape="diamond", style="filled", width=1.3, height=0.8];

    leyenda_usuario -> leyenda_contacto [color="#0066CC", style="bold", label="tiene", fontcolor="#0066CC"];
    leyenda_usuario -> leyenda_comun [color="#CC0000", style="bold,dashed", label="común", fontcolor="#CC0000"];
  }

