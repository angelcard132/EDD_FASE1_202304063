digraph ListaContactos {
  rankdir=LR;
  node [shape=record, style=filled, fillcolor=lightyellow];
  edge [color=orange, style=bold];

  // Título
  titulo [label="LISTA CIRCULAR - CONTACTOS\\nUsuario: mshuttleworth@edd.com", shape=box, style=filled, fillcolor=yellow];

  contacto0 [label="ID: 602763|Nombre: melvin|Email: melvin@edd.com"];

  // Conexiones circulares
  titulo -> contacto0;
  contacto0 -> contacto0 [label="sig", color=red, style=dashed];
}
