digraph ListaContactos {
  rankdir=LR;
  node [shape=record, style=filled, fillcolor=lightyellow];
  edge [color=orange, style=bold];

  // Título
  titulo [label="LISTA CIRCULAR - CONTACTOS\\nUsuario: smejia@edd.com", shape=box, style=filled, fillcolor=yellow];

  vacia [label="Lista Vacía", shape=box, style=filled, fillcolor=red];
  titulo -> vacia;
}
